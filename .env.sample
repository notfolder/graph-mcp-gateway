# 接続情報の見本。値はダミー。実際の値は .env に書く（.env はコミットしない）。
# docker compose は .env の値を compose.yaml に埋め込む。空の値は「未設定」として扱う。

# ---- 公開のホスト名と受け口 ---------------------------------------------------
# 公開のホスト名（サーバー証明書と Entra ID の戻り先に入れた名前と同じにする）
PUBLIC_HOSTNAME=mcp.example.invalid
# 受け口の HTTPS の番号（既定 443）と、Open WebUI の HTTPS の番号（既定 8443）
GATEWAY_HTTPS_PORT=443
GATEWAY_OPENWEBUI_HTTPS_PORT=8443
# サーバー証明書のディレクトリ（server.crt に中間証明書まで、server.key に秘密鍵を置く）
GATEWAY_CERT_DIR=./certs
# 要求の本文の上限
GATEWAY_CLIENT_MAX_BODY_SIZE=16m

# ---- Entra ID のアプリ（中継の 2 つの受け口で共通）---------------------------
# アプリ（クライアント）ID
APP_CLIENT_ID=00000000-0000-0000-0000-000000000000
# クライアントシークレット（秘密）
APP_CLIENT_SECRET=dummy-replace-with-real-secret
# テナント ID（common・organizations・consumers は使えない）
APP_TENANT_ID=00000000-0000-0000-0000-000000000000
# API の公開で作ったスコープ名（api:// を付けない。カンマ区切り）
APP_REQUIRED_SCOPES=mcp.access
# Entra ID の接続先のホスト（通常は空。mock モードだけ模擬に向ける）
APP_ENTRA_BASE_AUTHORITY=

# ---- 中継の任意の設定（空なら FastMCP の既定）-------------------------------
# 接続の確認画面の出し方（true / false / remember / external）
APP_REQUIRE_CONSENT=
# AI ツールの戻り先の制限（カンマ区切りのパターン）
APP_ALLOWED_CLIENT_REDIRECT_URIS=
# CIMD の受け付け（true / false）
APP_ENABLE_CIMD=
# MCP サーバーのアクセストークンの有効期限（秒）
APP_ACCESS_TOKEN_EXPIRY_SECONDS=

# ---- 台数を増やす構成（使うときだけ書く）-----------------------------------
# COMPOSE_PROFILES=multi
# MCP サーバーのトークンの署名鍵（秘密。十分に長い乱数）
APP_JWT_SIGNING_KEY=
# 共有の保管先
APP_STORAGE_REDIS_URL=
# Redis に書く中身の暗号化キー（秘密。python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" で作る）
APP_STORAGE_ENCRYPTION_KEY=
# MCP のセッションを持たない動作（true / false）
APP_STATELESS_HTTP=
# 各部分の台数（既定 1。変えたら docker compose restart gateway）
RELAY_FULL_REPLICAS=1
RELAY_DISCOVERY_REPLICAS=1
MS365_FULL_REPLICAS=1
MS365_DISCOVERY_REPLICAS=1

# ---- ms-365-mcp-server の変えられる値（空なら既定）---------------------------
# 1 回に取る件数の上限（既定 50）、全ページの取得のページ数（既定 5）と件数（既定 250）の上限
MS365_MAX_TOP=
MS365_MAX_PAGES=
MS365_MAX_ITEMS=
# ファイルの中身の上限（バイト、既定 1048576）
MS365_BLOB_MAX_BYTES=
# Graph の再試行の回数（既定 3）
MS365_GRAPH_MAX_RETRIES=
# 探して使う受け口で直接出すツール（カンマ区切り、完全一致。既定は空）
MS365_EAGER_TOOLS=

# ---- 社内のプロキシ（外へ出るのに要る場合だけ）-----------------------------
HTTPS_PROXY=
NO_PROXY=

# ---- PoC 専用の Open WebUI ---------------------------------------------------
# ログインのトークンと保管する OAuth の情報の暗号化の鍵（秘密。固定し、変えない）
WEBUI_SECRET_KEY=dummy-replace-with-random-secret
# 起動時に作る管理者（パスワードは秘密）
WEBUI_ADMIN_EMAIL=admin@example.invalid
WEBUI_ADMIN_PASSWORD=dummy-replace-with-strong-password
WEBUI_ADMIN_NAME=PoC 管理者
# Open WebUI と初期設定のスクリプトが信頼する認証局の束（社内の認証局 ＋ 公開の認証局）
OPENWEBUI_CA_BUNDLE=./certs/ca-bundle.pem

# PoC 専用の Open WebUI がつなぐ言語モデル（OpenAI 互換の API）
# 社外では Claude の API、社内では社内の言語モデルの接続先を書く
OPENWEBUI_LLM_BASE_URL=https://api.anthropic.com/v1/
OPENWEBUI_LLM_API_KEY=dummy-replace-with-real-key
OPENWEBUI_LLM_MODEL=claude-haiku-5-5

# ---- real モードの E2E だけ ----------------------------------------------------
# 公開 URL の証明書を確かめる認証局の証明書（ホストのパス）
E2E_CA_BUNDLE=./certs/ca-bundle.pem
# 利用者 B のデータの ID（利用者 A のトークンで取れないことを確かめる）
E2E_REAL_OTHER_USER_MESSAGE_ID=
E2E_REAL_OTHER_USER_EVENT_ID=
E2E_REAL_OTHER_USER_CHAT_ID=
E2E_REAL_OTHER_USER_DRIVE_ITEM_ID=
