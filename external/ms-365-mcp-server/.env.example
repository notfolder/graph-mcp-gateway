# ms-365-mcp-server のコンテナに渡す設定の一覧。秘密情報は無い（値は見本）
# 組織用のモード（Teams・SharePoint のツールを含める）
MS365_MCP_ORG_MODE=true
# 依頼資料 P-5 の 12 権限（空白区切り）
MS365_MCP_ALLOWED_SCOPES="User.Read Mail.ReadWrite Mail.Send Calendars.ReadWrite Files.ReadWrite.All Sites.ReadWrite.All Chat.ReadWrite ChatMessage.Send Team.ReadBasic.All Channel.ReadBasic.All ChannelMessage.Read.All ChannelMessage.Send"
# 出さない 2 ツールを外す絞り込み（正規表現。書き方は詳細設計で決める）
ENABLED_TOOLS=
# 要求元ごとの回数の制限を外す
MS365_MCP_RATE_LIMIT_DISABLED=true
# 回路遮断器を無効にする
MS365_MCP_GRAPH_CIRCUIT_DISABLED=true
# 動的なクライアント登録の受け口を止める
MS365_MCP_DISABLE_DCR=true
# ログ：警告以上だけ、監査のログを止める、置き場所
LOG_LEVEL=warn
MS365_MCP_AUDIT_LOG=false
MS365_MCP_LOG_DIR=/tmp/ms365-logs
# 探して使う方だけ：直接出すツール（カンマ区切り、完全一致。最初は空）
MS365_MCP_EAGER_TOOLS=
# ツールの応答の大きさの上限（値は詳細設計で決める）
MS365_MCP_MAX_TOP=
MS365_MCP_MAX_PAGES=
MS365_MCP_MAX_ITEMS=
MS365_MCP_BLOB_OUTPUT=true
MS365_MCP_BLOB_MAX_BYTES=
# Graph の再試行の回数（既定 3）
MS365_MCP_GRAPH_MAX_RETRIES=3
# mock モードだけ：Dev Proxy に通す
NODE_USE_ENV_PROXY=
HTTPS_PROXY=
NODE_EXTRA_CA_CERTS=
