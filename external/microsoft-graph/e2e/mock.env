# mock モード：ms-365-mcp-server の Graph への要求を Dev Proxy（external/microsoft-graph/mock）に通す。
# ms-365-mcp-server のコンテナに渡す（external/ms-365-mcp-server/e2e/mock.env と同じ値）。
# Node の fetch は、NODE_USE_ENV_PROXY=1 が無いと HTTPS_PROXY を読まない（組で必須）。
NODE_USE_ENV_PROXY=1
HTTPS_PROXY=http://devproxy:8000
# Dev Proxy のルート証明書（PEM）をマウントした場所。update-ca-certificates は Node に効かないので使わない。
NODE_EXTRA_CA_CERTS=/certs/devproxy-root.pem
