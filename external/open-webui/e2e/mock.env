# mock モード：PoC 専用の Open WebUI を、言語モデルの模擬と、TLS の本システムにつなぐ
# 公開 URL（https が必須。値は詳細設計で決める）
WEBUI_URL=https://owui.mock.invalid
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=user
ENABLE_OLLAMA_API=false
OFFLINE_MODE=true
# 手元の認証局と公開の認証局をまとめた証明書（2 系統に同じものを渡す）
AIOHTTP_CLIENT_SSL_CERT_FILE=/certs/ca-bundle.pem
SSL_CERT_FILE=/certs/ca-bundle.pem
# 付随の要求を止める（模擬の言語モデルの記録を読みやすくするため）
ENABLE_TITLE_GENERATION=false
ENABLE_TAGS_GENERATION=false
ENABLE_FOLLOW_UP_GENERATION=false
# 管理者と鍵は mock 用の固定値を compose で渡す（秘密情報ではない値にする）
