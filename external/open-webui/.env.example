# PoC 専用の Open WebUI の接続情報。値はダミー。実際の値はプロジェクト直下の .env に書く
# 公開 URL（https）
WEBUI_URL=https://owui.example.invalid
# ログインのトークンと保管する OAuth の情報の暗号化の鍵（秘密情報。固定する）
WEBUI_SECRET_KEY=dummy-replace-with-random-secret
# 起動時に作る管理者
WEBUI_ADMIN_EMAIL=admin@example.invalid
WEBUI_ADMIN_PASSWORD=dummy-replace-with-strong-password
WEBUI_ADMIN_NAME=PoC 管理者
# 言語モデルの接続先と鍵は external/language-model/.env.example の値から渡す
OPENAI_API_BASE_URL=https://example.invalid/v1/
OPENAI_API_KEY=dummy-replace-with-real-key
