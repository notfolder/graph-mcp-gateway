# E2E の mock モードの共通の設定（docker compose の --env-file に渡す）。値は模擬用の固定値で、秘密ではない。
# Entra ID は模擬（mock-entra）、Graph と CIMD の文書は Dev Proxy、言語モデルは模擬（mock-llm）。

# 公開のホスト名（compose の中で受け口が持つ別名）
PUBLIC_HOSTNAME=gateway
GATEWAY_HTTPS_PORT=443
GATEWAY_OPENWEBUI_HTTPS_PORT=8443
GATEWAY_CERT_DIR=./e2e/.work/certs/gateway
OPENWEBUI_CA_BUNDLE=./e2e/.work/certs/owui-bundle.pem

# 模擬 Entra ID（external/entra-id/e2e/mock.env と同じ値）
APP_ENTRA_BASE_AUTHORITY=mock-entra:8443
APP_TENANT_ID=00000000-0000-0000-0000-000000000001
APP_CLIENT_ID=11111111-1111-1111-1111-111111111111
APP_CLIENT_SECRET=mock-client-secret-not-a-real-secret
APP_REQUIRED_SCOPES=mcp.access
MOCK_ACCESS_TOKEN_LIFETIME=60

# 中継：CIMD の文書を Dev Proxy 経由で取る。Entra ID の模擬・中継先・Redis へは直接
FASTMCP_SSRF_TRUST_PROXY=true
HTTPS_PROXY=http://devproxy:8000
NO_PROXY=mock-entra,ms365-full,ms365-discovery,redis

# ms-365-mcp-server：Graph への要求を Dev Proxy に通す（external/ms-365-mcp-server/e2e/mock.env と同じ値）
NODE_USE_ENV_PROXY=1
NODE_EXTRA_CA_CERTS=/certs/devproxy-root.pem

# Dev Proxy の API のトークン（mock 用の固定値。32 文字以上）
DEV_PROXY_API_TOKEN=mock-devproxy-api-token-0123456789abcdef

# PoC 専用の Open WebUI（external/open-webui/e2e/mock.env と言語モデルの模擬）
WEBUI_SECRET_KEY=mock-webui-secret-key-not-a-real-secret
WEBUI_ADMIN_EMAIL=admin@example.test
WEBUI_ADMIN_PASSWORD=mock-admin-password
WEBUI_ADMIN_NAME=E2E Admin
OPENWEBUI_LLM_BASE_URL=http://mock-llm:8080/v1
OPENWEBUI_LLM_API_KEY=mock-key-not-secret
OPENWEBUI_LLM_MODEL=mock-model

# E2E の実行役
E2E_MODE=mock
E2E_BASE_HOST=gateway
E2E_CA_BUNDLE=/certs/e2e-bundle.pem
