# 受け口（nginx）の設定のテンプレート。nginx の公式イメージが起動時に ${...} を環境変数の値で埋める。
# 443 番：2 つの MCP の受け口（/full/ と /discovery/）と、そのメタデータ。
# 8443 番：PoC 専用の Open WebUI。
# upstream はサービス名で書く。台数を増やすと名前解決の全部の IP に順に振り分ける（台数を変えたら gateway を再起動する）。

upstream relay_full {
    server relay-full:8000;
    keepalive 16;
}

upstream relay_discovery {
    server relay-discovery:8000;
    keepalive 16;
}

upstream open_webui {
    server open-webui:8080;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    server_name ${PUBLIC_HOSTNAME};

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size ${GATEWAY_CLIENT_MAX_BODY_SIZE};

    proxy_http_version      1.1;
    proxy_buffering         off;
    proxy_request_buffering off;
    proxy_read_timeout      3600s;
    proxy_send_timeout      3600s;
    proxy_set_header Host              $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header Connection        "";

    # 受け口：前置きを外して中継へ
    location /full/ {
        proxy_pass http://relay_full/;
    }
    location /discovery/ {
        proxy_pass http://relay_discovery/;
    }

    # 保護リソースのメタデータ：前置きを外さずに転送
    location /.well-known/oauth-protected-resource/full/ {
        proxy_pass http://relay_full;
    }
    location /.well-known/oauth-protected-resource/discovery/ {
        proxy_pass http://relay_discovery;
    }

    # 認可サーバーのメタデータ（パスを挿入した形）：中継の直下の形に書き換えて転送
    location = /.well-known/oauth-authorization-server/full {
        proxy_pass http://relay_full/.well-known/oauth-authorization-server;
    }
    location = /.well-known/openid-configuration/full {
        proxy_pass http://relay_full/.well-known/openid-configuration;
    }
    location = /.well-known/oauth-authorization-server/discovery {
        proxy_pass http://relay_discovery/.well-known/oauth-authorization-server;
    }
    location = /.well-known/openid-configuration/discovery {
        proxy_pass http://relay_discovery/.well-known/openid-configuration;
    }

    # それ以外は届けない
    location / {
        return 404;
    }
}

server {
    listen 8443 ssl;
    server_name ${PUBLIC_HOSTNAME};

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size ${GATEWAY_CLIENT_MAX_BODY_SIZE};

    location / {
        proxy_pass              http://open_webui;
        proxy_http_version      1.1;
        proxy_buffering         off;
        proxy_request_buffering off;
        proxy_read_timeout      3600s;
        proxy_send_timeout      3600s;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }
}
